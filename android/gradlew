#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GRADLE_VERSION="${GRADLE_VERSION:-7.6.4}"
GRADLE_HOME="${ROOT_DIR}/.gradle/gradle-${GRADLE_VERSION}"
GRADLE_BIN="${GRADLE_HOME}/bin/gradle"
DIST_URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
DIST_ZIP="${ROOT_DIR}/.gradle/gradle-${GRADLE_VERSION}-bin.zip"

if [ ! -x "${GRADLE_BIN}" ]; then
  mkdir -p "${ROOT_DIR}/.gradle"
  if [ ! -f "${DIST_ZIP}" ]; then
    curl -fL "${DIST_URL}" -o "${DIST_ZIP}"
  fi
  rm -rf "${GRADLE_HOME}" "${ROOT_DIR}/.gradle/gradle-${GRADLE_VERSION}"
  unzip -q "${DIST_ZIP}" -d "${ROOT_DIR}/.gradle"
fi

exec "${GRADLE_BIN}" "$@"
